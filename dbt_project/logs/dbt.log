            + try_cast(regexp_extract(Sector3Time, '(\\d{2}):(\\d{2}):(\\d{2})\\.(\\d{6})$', 4) as bigint) / 1000
    end
 AS sector3_time_ms,

    SpeedI1 AS speed_i1,
