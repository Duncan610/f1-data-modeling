  create or replace view `f1_project`.`silver`.`stg_drivers`
  
  as (
    WITH deduped AS(
    SELECT
        code AS driver_code,
        driverId AS driver_id,
        familyName AS family_name,
        givenName AS given_name,
        nationality,
        season,
        url AS driver_url,
